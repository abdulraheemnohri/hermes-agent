#!/data/data/com.termux/files/usr/bin/bash
set -u
ROOT="$(cd "$(dirname "$0")" && pwd)"
case "${1:-status}" in
 doctor|health) exec "$ROOT/tensor-doctor" ;;
 status) exec "$ROOT/tensor-status" ;;
 start) exec "$ROOT/tensor-server" start ;;
 stop) exec "$ROOT/tensor-server" stop ;;
 model) exec "$ROOT/tensor-model" "${@:2}" ;;
 model-manager) exec "$ROOT/tensor-model-manager" "${@:2}" ;;
 compat) exec "$ROOT/tensor-compat" "${@:2}" ;;
 lm) exec "$ROOT/tensor-lm" "${@:2}" ;;
 server) exec "$ROOT/tensor-server" "${@:2}" ;;
 runtime) exec "$ROOT/tensor-runtime" "${@:2}" ;;
 profile) exec "$ROOT/tensor-profile" "${@:2}" ;;
 thermal) exec "$ROOT/tensor-thermal" "${@:2}" ;;
 hermes) exec "$ROOT/hermes-tensor" "${@:2}" ;;
 setup) exec "$ROOT/tensor-setup" ;;
 version) echo "Hermes Tensor / Termux CLI 1.2.0" ;;
 *) echo "Usage: tensor doctor|status|start|stop|model|model-manager|compat|lm|server|runtime|profile|thermal|hermes|setup|version"; exit 2 ;;
esac
