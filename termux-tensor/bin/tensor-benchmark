#!/data/data/com.termux/files/usr/bin/bash
set -u
ROOT="$(cd "$(dirname "$0")" && pwd)"
[ -f "$ROOT/tensor-env" ] && . "$ROOT/tensor-env"
HOME_DIR="${HERMES_HOME:-$HOME/.hermes}"
HISTORY_DIR="$HOME_DIR/tensor/runtime/benchmarks"
HISTORY="$HISTORY_DIR/history.tsv"
mkdir -p "$HISTORY_DIR"
now(){ date -u '+%Y-%m-%dT%H:%M:%SZ'; }
device_id(){ printf '%s' "$(getprop ro.soc.model 2>/dev/null || echo unknown)|$(uname -m)|$(getprop ro.build.version.sdk 2>/dev/null || echo unknown)" | sha256sum | awk '{print substr($1,1,16)}'; }
model_path(){ cat "$HOME_DIR/tensor/state/current-model" 2>/dev/null || true; }
file_size(){ [ -f "$1" ] && wc -c < "$1" | tr -d " " || echo 0; }
thermal(){ awk '{printf "%.1f",$1/1000; exit}' /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0; }
ram(){ awk '/MemAvailable/ {printf "%.0f",$2/1024; exit}' /proc/meminfo 2>/dev/null || echo 0; }
case "${1:-status}" in
 status) echo "Benchmark history: $HISTORY"; [ -f "$HISTORY" ] && { echo "Runs: $(wc -l < "$HISTORY")"; tail -n 10 "$HISTORY"; } || echo "No benchmark history";;
 record) model="${2:-$(model_path)}"; result="${3:-}"; [ -n "$model" ] || { echo "ERROR: no model selected" >&2; exit 2; }; [ -n "$result" ] || { echo "Usage: tensor benchmark record <model> <result-file-or-summary>" >&2; exit 2; }; if [ ! -f "$HISTORY" ]; then printf "timestamp\tdevice_id\tmodel\tmodel_bytes\tthermal_c\tavailable_ram_mb\tresult\n" > "$HISTORY"; fi; printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "$(now)" "$(device_id)" "$model" "$(file_size "$model")" "$(thermal)" "$(ram)" "$result" >> "$HISTORY"; echo "Recorded benchmark run";;
 compare) [ -f "$HISTORY" ] || { echo "No benchmark history"; exit 1; }; tail -n +2 "$HISTORY" | awk -F "\t" '{print $1 " | " $3 " | " $4 " bytes | " $5 " C | " $6 " MB | " $7}' | tail -n 20;;
 regression) [ -f "$HISTORY" ] || { echo "No benchmark history"; exit 1; }; rows="$(tail -n +2 "$HISTORY" | wc -l)"; if [ "$rows" -lt 2 ]; then echo "Insufficient history: need at least 2 recorded runs"; exit 0; fi; echo "Regression analysis is conservative: compare recorded result summaries for identical model/device entries."; tail -n 10 "$HISTORY";;
 *) echo "Usage: tensor benchmark status|record <model> <result-summary>|compare|regression"; exit 2;;
esac
