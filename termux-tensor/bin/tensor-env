#!/data/data/com.termux/files/usr/bin/bash
set -u
HOME_DIR="${HERMES_HOME:-$HOME/.hermes}"
CONF="$HOME_DIR/tensor/config/tensor.conf"
[ -f "$CONF" ] && . "$CONF"
export HERMES_HOME="$HOME_DIR"
export TENSOR_MODEL_DIR="${TENSOR_MODEL_DIR:-$HOME_DIR/models}"
export TENSOR_HOST="${TENSOR_HOST:-127.0.0.1}"
export TENSOR_PORT="${TENSOR_PORT:-9379}"
export TENSOR_THERMAL_MODE="${TENSOR_THERMAL_MODE:-balanced}"
export TENSOR_LOG_LEVEL="${TENSOR_LOG_LEVEL:-INFO}"
export TENSOR_READY_TIMEOUT="${TENSOR_READY_TIMEOUT:-15}"
export TENSOR_MIN_FREE_RAM_MB="${TENSOR_MIN_FREE_RAM_MB:-1024}"
export TENSOR_MODEL_RAM_FACTOR="${TENSOR_MODEL_RAM_FACTOR:-1.5}"
export TENSOR_MODEL_STORAGE_FACTOR="${TENSOR_MODEL_STORAGE_FACTOR:-1.2}"
export TENSOR_BENCHMARK_PREFILL_TOKENS="${TENSOR_BENCHMARK_PREFILL_TOKENS:-1024}"
export TENSOR_BENCHMARK_DECODE_TOKENS="${TENSOR_BENCHMARK_DECODE_TOKENS:-256}"
